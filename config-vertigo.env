# KernelSU Action -- build profile (vertigo base, boot test)
#
# Device : Xiaomi Redmi Note 7 Pro (violet, SM6150, Android 10 / MIUI Q)
# Kernel : rokusenpaislab/android_kernel_vertigo @ master
#          (CAF LA.UM.9.1.r1-13000-SMxxx0.QSSI12.0, QCOM ICE + blk-crypto fscrypt)
#
# Goal of this profile: does this tree boot MIUI 12.5 with existing /data?
# KernelSU is OFF here on purpose (isolate the base kernel).
# KernelSU Action -- build profile
#
# Device : Xiaomi Redmi Note 7 Pro (violet, SM6150, Android 10 / MIUI Q)
# Kernel : fa98qq/Xiaomi_Kernel_OpenSource @ violet-q-oss (Linux 4.14.117)
#
# Values here are defaults; workflow_dispatch inputs override them per run.


# ============================================================ Kernel source ==

KERNEL_SOURCE=https://github.com/rokusenpaislab/android_kernel_vertigo
KERNEL_SOURCE_BRANCH=master
KERNEL_CONFIG=vendor/violet-perf_defconfig
KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64

# Leave blank: the device label is derived from the defconfig name (violet).
KERNEL_NAME=

ADD_LOCALVERSION_TO_FILENAME=false

# This 4.14 tree predates -Wno-error defaults and has K&R-style prototypes in
# vendor drivers. Keep clang's diagnostics visible but never fatal.
EXTRA_CMDS: KCFLAGS=-Wno-error
CUSTOM_CMDS: CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
#
# clang 12 (r416183b) is the toolchain LineageOS 19 used for msm-4.14 sm6150
# kernels, and it is a verified pair for master-kernel-build-2021.
CLANG_BRANCH=master-kernel-build-2021
CLANG_VERSION=r416183b

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

# Full-LLVM build (LLVM=1 LLVM_IAS=1) is not reliable on 4.14.
USE_LLVM=false

# ===================================================================== GCC ==
#
# GCC 4.9 binutils only (AOSP android-12.1.0_r27 prebuilts), same as Xiaomi's
# original build: clang compiles, GNU ld/as link and assemble.
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===
#
# KernelSU-Next (successor of tiann/KernelSU) keeps non-GKI support in its
# 'legacy' branch; the manager app is v3.x, far newer than 0.9.5.
KSU_VARIANT=none
KSU_REF=

# 4.14 has no kprobes-safe non-GKI hook path: the bundled sed script patches the
# syscall entry points (execveat/faccessat/stat/vfs_read/input) directly.
KSU_HOOK_MODE=none

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===

# path_umount() landed in 5.9; backported into fs/namespace.c here.
ENABLE_PATH_UMOUNT=false

ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ===

# Must stay false for manual hooks on 0.9.5: ksud.c only defines the
# ksu_vfs_read_hook / ksu_execveat_hook / ksu_input_hook flags in its #else
# branch (no kprobes), and those are exactly the flags the manual hook patch
# calls into. With kprobes enabled they are undefined and vmlinux fails to link.
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=true
DISABLE_CC_WERROR=true

EXTRA_DEFCONFIG=CONFIG_TMPFS_XATTR=y

# ============================================================= AnyKernel3 ===

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===

NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
